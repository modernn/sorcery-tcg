{
  "name": "sorcery-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "game:demo": "cargo run --release --locked --quiet -p sorcery-engine --bin sorcery-engine -- demo",
    "game:batch": "cargo run --release --locked --quiet -p sorcery-engine --bin sorcery-engine -- batch",
    "game:selfplay-acceptance": "cargo test --release --locked -p sorcery-engine --test selfplay production_sized_campaign_should_promote_and_seal_reproducibly -- --ignored --exact --nocapture",
    "game:check-private": "node src/commands/run-private-game-check.ts",
    "game:verify-private": "node --test tests/private-authority/private-game-scenario.test.ts",
    "game:novelty-private": "node src/commands/run-private-novelty-gauntlet.ts",
    "game:report-private-mechanics": "node src/commands/report-private-mechanic-workload.ts",
    "play": "node src/prototype/game-server.ts",
    "prototype": "node src/prototype/server.ts",
    "typecheck": "node --stack-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "authority:import": "node src/commands/import-authority.ts",
    "cards:catalog-build": "node src/commands/build-card-catalog.ts",
    "decks:import-topdeck": "node src/commands/import-topdeck-candidates.ts",
    "authority:validate": "node src/commands/validate-authority.ts",
    "authority:verify-private": "node --test --test-concurrency=1 tests/private-authority/*.test.ts",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 tests/authority/*.test.ts tests/engine/*.test.ts tests/ingestion/*.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
