{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sorcery.local/schemas/rust-engine-benchmark-v2.json",
  "title": "Sorcery Rust engine benchmark v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate",
    "benchmarkVersion",
    "configuration",
    "environment",
    "gameReplay",
    "measuredAtUnixMs",
    "pairedRollout",
    "searchNodes",
    "transitions"
  ],
  "properties": {
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "benchmarkVersion": {
      "const": 2
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gamesPerSample",
        "pairedRolloutRepetitionsPerSample",
        "sampleCount",
        "searchHorizon",
        "seeds"
      ],
      "properties": {
        "gamesPerSample": { "$ref": "#/$defs/positiveInteger" },
        "pairedRolloutRepetitionsPerSample": { "$ref": "#/$defs/positiveInteger" },
        "sampleCount": { "$ref": "#/$defs/positiveInteger" },
        "searchHorizon": { "type": "integer", "minimum": 1, "maximum": 32 },
        "seeds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "cpu",
        "logicalCpuCount",
        "mode",
        "os",
        "peakRssMeasurement",
        "totalMemoryBytes"
      ],
      "properties": {
        "arch": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "logicalCpuCount": { "$ref": "#/$defs/positiveInteger" },
        "mode": { "const": "rust-release" },
        "os": { "type": "string", "minLength": 1 },
        "peakRssMeasurement": {
          "enum": ["linux-proc-vmhwm", "unavailable-without-unsafe-or-dependency"]
        },
        "totalMemoryBytes": { "type": "null" }
      }
    },
    "gameReplay": { "$ref": "#/$defs/summary" },
    "measuredAtUnixMs": { "type": "integer", "minimum": 0 },
    "pairedRollout": { "$ref": "#/$defs/pairedRollout" },
    "searchNodes": { "$ref": "#/$defs/summary" },
    "transitions": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "games",
        "gamesPerSecond",
        "peakRssBytes",
        "searchNodes",
        "searchNodesPerSecond",
        "transitions",
        "transitionsPerSecond"
      ],
      "properties": {
        "games": { "$ref": "#/$defs/positiveInteger" },
        "gamesPerSecond": { "$ref": "#/$defs/nonnegativeNumber" },
        "peakRssBytes": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "searchNodes": { "$ref": "#/$defs/positiveInteger" },
        "searchNodesPerSecond": { "$ref": "#/$defs/nonnegativeNumber" },
        "transitions": { "$ref": "#/$defs/positiveInteger" },
        "transitionsPerSecond": { "$ref": "#/$defs/nonnegativeNumber" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "latencyMs", "throughputPerSecond"],
      "properties": {
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs", "operations", "perSecond"],
          "properties": {
            "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
            "operations": { "$ref": "#/$defs/positiveInteger" },
            "perSecond": { "$ref": "#/$defs/nonnegativeNumber" }
          }
        },
        "latencyMs": { "$ref": "#/$defs/percentiles" },
        "throughputPerSecond": { "$ref": "#/$defs/percentiles" }
      }
    },
    "pairedRollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate",
        "estimated60SecondCapacity",
        "pairLatencyMs",
        "replayPreflightOrientations",
        "samples",
        "seed",
        "throughputPerSecond",
        "uniqueSeeds"
      ],
      "properties": {
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs", "games", "pairs", "transitions"],
          "properties": {
            "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
            "games": { "$ref": "#/$defs/positiveInteger" },
            "pairs": { "$ref": "#/$defs/positiveInteger" },
            "transitions": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        "estimated60SecondCapacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["games", "method", "pairs", "transitions", "workload"],
          "properties": {
            "games": { "$ref": "#/$defs/positiveInteger" },
            "method": { "const": "singleThreadShortSampleEstimate" },
            "pairs": { "$ref": "#/$defs/positiveInteger" },
            "transitions": { "$ref": "#/$defs/positiveInteger" },
            "workload": { "const": "twoSeatSpeculativeRolloutOnly" }
          }
        },
        "pairLatencyMs": { "$ref": "#/$defs/percentiles" },
        "replayPreflightOrientations": { "const": 2 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["durationMs", "games", "pairs", "transitions"],
            "properties": {
              "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
              "games": { "$ref": "#/$defs/positiveInteger" },
              "pairs": { "$ref": "#/$defs/positiveInteger" },
              "transitions": { "$ref": "#/$defs/positiveInteger" }
            }
          }
        },
        "seed": { "$ref": "#/$defs/seed" },
        "throughputPerSecond": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gamesMedian",
            "gamesP95",
            "pairsMedian",
            "pairsP95",
            "transitionsMedian",
            "transitionsP95"
          ],
          "properties": {
            "gamesMedian": { "$ref": "#/$defs/nonnegativeNumber" },
            "gamesP95": { "$ref": "#/$defs/nonnegativeNumber" },
            "pairsMedian": { "$ref": "#/$defs/nonnegativeNumber" },
            "pairsP95": { "$ref": "#/$defs/nonnegativeNumber" },
            "transitionsMedian": { "$ref": "#/$defs/nonnegativeNumber" },
            "transitionsP95": { "$ref": "#/$defs/nonnegativeNumber" }
          }
        },
        "uniqueSeeds": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p95"],
      "properties": {
        "median": { "$ref": "#/$defs/nonnegativeNumber" },
        "p95": { "$ref": "#/$defs/nonnegativeNumber" }
      }
    },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "nonnegativeNumber": { "type": "number", "minimum": 0 }
  }
}
