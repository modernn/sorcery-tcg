{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sorcery.local/schemas/rust-engine-benchmark-v1.json",
  "title": "Sorcery Rust engine benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate",
    "benchmarkVersion",
    "configuration",
    "environment",
    "gameReplay",
    "measuredAtUnixMs",
    "searchNodes",
    "transitions"
  ],
  "properties": {
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "benchmarkVersion": {
      "const": 1
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gamesPerSample", "sampleCount", "searchHorizon", "seeds"],
      "properties": {
        "gamesPerSample": { "$ref": "#/$defs/positiveInteger" },
        "sampleCount": { "$ref": "#/$defs/positiveInteger" },
        "searchHorizon": { "type": "integer", "minimum": 1, "maximum": 32 },
        "seeds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "cpu",
        "logicalCpuCount",
        "mode",
        "os",
        "peakRssMeasurement",
        "totalMemoryBytes"
      ],
      "properties": {
        "arch": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "logicalCpuCount": { "$ref": "#/$defs/positiveInteger" },
        "mode": { "const": "rust-release" },
        "os": { "type": "string", "minLength": 1 },
        "peakRssMeasurement": {
          "enum": ["linux-proc-vmhwm", "unavailable-without-unsafe-or-dependency"]
        },
        "totalMemoryBytes": { "type": "null" }
      }
    },
    "gameReplay": { "$ref": "#/$defs/summary" },
    "measuredAtUnixMs": { "type": "integer", "minimum": 0 },
    "searchNodes": { "$ref": "#/$defs/summary" },
    "transitions": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "games",
        "gamesPerSecond",
        "peakRssBytes",
        "searchNodes",
        "searchNodesPerSecond",
        "transitions",
        "transitionsPerSecond"
      ],
      "properties": {
        "games": { "$ref": "#/$defs/positiveInteger" },
        "gamesPerSecond": { "$ref": "#/$defs/nonnegativeNumber" },
        "peakRssBytes": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "searchNodes": { "$ref": "#/$defs/positiveInteger" },
        "searchNodesPerSecond": { "$ref": "#/$defs/nonnegativeNumber" },
        "transitions": { "$ref": "#/$defs/positiveInteger" },
        "transitionsPerSecond": { "$ref": "#/$defs/nonnegativeNumber" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate", "latencyMs", "throughputPerSecond"],
      "properties": {
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs", "operations", "perSecond"],
          "properties": {
            "durationMs": { "$ref": "#/$defs/nonnegativeNumber" },
            "operations": { "$ref": "#/$defs/positiveInteger" },
            "perSecond": { "$ref": "#/$defs/nonnegativeNumber" }
          }
        },
        "latencyMs": { "$ref": "#/$defs/percentiles" },
        "throughputPerSecond": { "$ref": "#/$defs/percentiles" }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p95"],
      "properties": {
        "median": { "$ref": "#/$defs/nonnegativeNumber" },
        "p95": { "$ref": "#/$defs/nonnegativeNumber" }
      }
    },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nonnegativeNumber": { "type": "number", "minimum": 0 }
  }
}
